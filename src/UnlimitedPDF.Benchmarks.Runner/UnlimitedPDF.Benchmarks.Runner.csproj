<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>BenchmarkDotNet workloads, the pre-measurement validation pass and run provenance.</Description>
    <!-- BenchmarkDotNet needs full PDBs off and optimisations on; Release is enforced by the scripts. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnlimitedPDF.Benchmarks.Core\UnlimitedPDF.Benchmarks.Core.csproj" />
    <ProjectReference Include="..\UnlimitedPDF.Benchmarks.Adapters\UnlimitedPDF.Benchmarks.Adapters.csproj" />
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

</Project>
