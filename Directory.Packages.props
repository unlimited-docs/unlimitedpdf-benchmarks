<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!--
    Every version below was reviewed for licence, notices and known vulnerabilities.
    See docs/library-licenses.md before changing or adding a version.
  -->
  <ItemGroup Label="Benchmarked PDF libraries">
    <PackageVersion Include="UnlimitedPDF" Version="1.1.0" />
    <!-- 6.5.0 and later are AGPL-3.0-only; 6.2.4 is the last MIT release. -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="SkiaSharp" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.157.0" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0.200" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.200" />
  </ItemGroup>
  <ItemGroup Label="Validation only (never benchmarked)">
    <PackageVersion Include="Docnet.Core" Version="2.6.0" />
  </ItemGroup>
  <ItemGroup Label="Security overrides">
    <!-- PDFsharp 6.2.4 depends on 8.0.1, which has GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
